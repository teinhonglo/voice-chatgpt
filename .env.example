# Required. Keep this value on the server only.
OPENAI_API_KEY=sk-your-key

# Optional model overrides.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional server settings used by run_dual_mode.sh.
HOST=0.0.0.0
PORT=7860

# Optional. Leave unset for a temporary trycloudflare.com Quick Tunnel.
# For a stable hostname, create a remotely-managed tunnel in Cloudflare and
# paste its connector token here or export it before running run_public.sh.
CLOUDFLARE_TUNNEL_TOKEN=
