# Required. Keep this value on the server only.
OPENAI_API_KEY=sk-your-key

# Optional model overrides.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional RAG settings. Generate a stable signing secret with:
# openssl rand -hex 32
RAG_TOKEN_SECRET=
RAG_EXPIRY_DAYS=7
RAG_MAX_RESULTS=5
MAX_RAG_FILES_PER_UPLOAD=10
MAX_RAG_FILES_PER_KNOWLEDGE_BASE=50
MAX_RAG_FILE_BYTES=20971520
MAX_RAG_TOTAL_BYTES=52428800
RAG_INDEX_TIMEOUT_SECONDS=120

# Optional server settings used by run_dual_mode.sh.
HOST=0.0.0.0
PORT=7860

# Optional. Leave unset for a temporary trycloudflare.com Quick Tunnel.
# For a stable hostname, create a remotely-managed tunnel in Cloudflare and
# paste its connector token here or export it before running run_public.sh.
CLOUDFLARE_TUNNEL_TOKEN=
