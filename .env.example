# Required. Keep this value on the server only.
OPENAI_API_KEY=sk-your-key

# Startup environment selection. Startup scripts source path.sh and activate
# the corresponding Conda environment. Supported values: openai, local.
BACKEND=openai
# Set to 0 when vLLM/Ollama and Qdrant are already started and managed outside
# this project. BACKEND=local will then activate Conda without starting Docker.
MANAGE_LOCAL_SERVICES=1
# Set to 1 only when local Ollama models are already managed separately.
SKIP_LOCAL_MODEL_PULL=0

# Optional model overrides.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Transcription-only Realtime model used by Local Full Duplex.
OPENAI_REALTIME_ASR_MODEL=gpt-live-transcribe

# Local LLM and embedding services. Ollama is the documented default; any
# OpenAI-compatible endpoint (including vLLM) can be used instead.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=qwen3:8b
# Other RTX 3090-friendly choices shown in the UI:
# qwen3:14b, llama3.1:8b, gemma3:12b, deepseek-r1:14b
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_EMBEDDING_API_KEY=local
LOCAL_EMBEDDING_MODEL=bge-m3

# Local vector database.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
LOCAL_RAG_MAX_RESULTS=5
LOCAL_RAG_CHUNK_SIZE=1200
LOCAL_RAG_CHUNK_OVERLAP=180
LOCAL_RAG_TOKEN_SECRET=

# Optional RAG settings. Generate a stable signing secret with:
# openssl rand -hex 32
RAG_TOKEN_SECRET=
RAG_EXPIRY_DAYS=7
RAG_MAX_RESULTS=5
MAX_RAG_FILES_PER_UPLOAD=10
MAX_RAG_FILES_PER_KNOWLEDGE_BASE=50
MAX_RAG_FILE_BYTES=20971520
MAX_RAG_TOTAL_BYTES=52428800
RAG_INDEX_TIMEOUT_SECONDS=120

# Optional server settings used by run_dual_mode.sh.
HOST=0.0.0.0
PORT=7860

# Optional. Leave unset for a temporary trycloudflare.com Quick Tunnel.
# For a stable hostname, create a remotely-managed tunnel in Cloudflare and
# paste its connector token here or export it before running run_public.sh.
CLOUDFLARE_TUNNEL_TOKEN=
